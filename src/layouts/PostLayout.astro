---
import BaseLayout from './BaseLayout.astro';

interface Frontmatter {
  title: string;
  description?: string;
  date: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  slug?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props as Props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const toDate = (value: Date | string | undefined): Date | undefined => {
  if (value == null || value === '') return undefined;
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? undefined : value;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed;
};

const pubDate = toDate(frontmatter.pubDate) ?? toDate(frontmatter.date);
const updatedDate = toDate(frontmatter.updatedDate);
const isoPublished = pubDate?.toISOString();
const isoModified = updatedDate?.toISOString();

const absoluteUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description ?? '',
  author: {
    '@type': 'Person',
    name: 'Chengshu',
  },
  url: absoluteUrl,
  inLanguage: 'zh-CN',
};

if (isoPublished) jsonLd.datePublished = isoPublished;
if (isoModified) jsonLd.dateModified = isoModified;
---

<BaseLayout title={`${frontmatter.title} · Chengshu`} description={frontmatter.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="post">
    <a class="back" href={base}>← 返回文章</a>
    <header>
      <p class="eyebrow">
        {isoPublished ? (
          <time datetime={isoPublished}>{frontmatter.date}</time>
        ) : (
          frontmatter.date
        )}
      </p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="dek">{frontmatter.description}</p>}
    </header>
    <div class="content"><slot /></div>
  </article>
</BaseLayout>

<style>
  .back { color: #666; font-size: .95rem; text-decoration: none; }
  .eyebrow { margin: 3rem 0 .5rem; color: #777; font-size: .82rem; letter-spacing: .06em; }
  h1 { margin: 0; font-size: clamp(2.5rem, 8vw, 4rem); }
  .dek { max-width: 38rem; color: #666; font-size: 1.15rem; }
  .content { margin-top: 3rem; }
  .content :global(h2) { margin-top: 2.5rem; }
  .content :global(p) { margin-block: 1.25rem; }
</style>
