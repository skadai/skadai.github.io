---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { tagPath } from '../lib/posts';

interface Frontmatter {
  title: string;
  description?: string;
  date: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  slug?: string;
  tags?: string[];
}

interface Props {
  frontmatter: Frontmatter;
  headings?: MarkdownHeading[];
  body?: string;
  series?: {
    title: string;
    label: string;
    href: string;
  };
}

const { frontmatter, headings = [], body = '', series } = Astro.props as Props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const tags = (frontmatter.tags ?? []).map((t) => t.trim()).filter(Boolean);

const toDate = (value: Date | string | undefined): Date | undefined => {
  if (value == null || value === '') return undefined;
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? undefined : value;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed;
};

const pubDate = toDate(frontmatter.pubDate) ?? toDate(frontmatter.date);
const updatedDate = toDate(frontmatter.updatedDate);
const showUpdated = updatedDate != null && pubDate != null && updatedDate.valueOf() > pubDate.valueOf();
const updatedLabel = showUpdated
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate!)
  : undefined;
const isoPublished = pubDate?.toISOString();
const isoModified = updatedDate?.toISOString();

/* 阅读量估算：中日韩字符按 400 字/分钟，拉丁单词按 220 词/分钟 */
const CJK = /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/g;
const stats = (() => {
  const text = body.replace(/```[\s\S]*?```/g, ' ');
  const cjk = (text.match(CJK) ?? []).length;
  const latin = (text.replace(CJK, ' ').match(/[A-Za-z0-9]+/g) ?? []).length;
  const minutes = Math.max(1, Math.round(cjk / 400 + latin / 220));
  const units = [];
  if (cjk) units.push(`${cjk.toLocaleString('zh-CN')} 字`);
  if (latin) units.push(`${latin.toLocaleString('zh-CN')} 词`);
  units.push(`约 ${minutes} 分钟`);
  return units.join(' · ');
})();

const toc = headings.filter((heading) => heading.depth === 2 && heading.text.trim());

const absoluteUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description ?? '',
  author: {
    '@type': 'Person',
    name: 'Chengshu',
  },
  url: absoluteUrl,
  inLanguage: 'zh-CN',
};

if (isoPublished) jsonLd.datePublished = isoPublished;
if (isoModified) jsonLd.dateModified = isoModified;
if (tags.length) jsonLd.keywords = tags.join(', ');
---

<BaseLayout title={`${frontmatter.title} · Chengshu`} description={frontmatter.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="post">
    <header class="article-head">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="面包屑">
          <span><a href={base}>Chengshu</a><span class="sep">/</span></span>
          <span><a href={base}>文章</a><span class="sep">/</span></span>
          <span>{frontmatter.title}</span>
        </nav>

        <div class="kicker-row">
          {isoPublished ? (
            <time datetime={isoPublished}>{frontmatter.date}</time>
          ) : (
            <span>{frontmatter.date}</span>
          )}
          <span class="sep" aria-hidden="true"></span>
          <span>{stats}</span>
          {updatedLabel && (
            <>
              <span class="sep" aria-hidden="true"></span>
              <span class="k">更新于 <time datetime={isoModified}>{updatedLabel}</time></span>
            </>
          )}
        </div>

        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="dek">{frontmatter.description}</p>}

        {tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li><a href={tagPath(tag, base)}>{tag}</a></li>
            ))}
          </ul>
        )}

        {series && (
          <p class="series-nav">
            本篇属于系列 <a href={series.href}>{series.title}</a> · {series.label}
          </p>
        )}
      </div>
    </header>

    <div class={`wrap article-body-wrap${toc.length > 1 ? ' toc-right' : ''}`}>
      <div class="prose"><slot /></div>

      {toc.length > 1 && (
        <aside class="toc toc-r" aria-label="本篇目录">
          <h4>本篇目录</h4>
          <ol>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </article>

  <section class="wrap comments-section" aria-label="讨论">
    <h2 class="comments-heading">讨论</h2>
    <p class="comments-body">
      这里是静态站点，没有内嵌评论区。如果这篇文章对你有用，欢迎通过 RSS 订阅后续更新。
    </p>
  </section>

  <script>
    // X / Twitter 内嵌：只在本页真的用到时才加载官方 widget，
    // 避免所有文章都背上第三方脚本。
    if (document.querySelector('.video-embed-x')) {
      const s = document.createElement('script');
      s.src = 'https://platform.twitter.com/widgets.js';
      s.async = true;
      s.charset = 'utf-8';
      document.head.appendChild(s);
    }

    // 目录高亮：滚动时点亮当前小节
    const toc = document.querySelector('.toc.toc-r');
    if (toc) {
      const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
      const targets = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((el): el is HTMLElement => el !== null);

      if (targets.length) {
        const visible = new Set<Element>();
        const setActive = () => {
          const first = targets.find((target) => visible.has(target));
          links.forEach((link) => {
            const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
            link.classList.toggle('active', target !== null && target === first);
          });
        };
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
            });
            setActive();
          },
          { rootMargin: '-96px 0px -70% 0px' },
        );
        targets.forEach((target) => observer.observe(target));
        setActive();
      }
    }
  </script>
</BaseLayout>
