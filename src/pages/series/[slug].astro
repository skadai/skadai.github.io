---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, tagPath } from '../../lib/posts';
import { getSeries, resolveSeries, type ResolvedSeries } from '../../lib/series';

export async function getStaticPaths() {
  return getSeries().map((series) => ({
    params: { slug: series.id },
    props: { series },
  }));
}

interface Props {
  series: ResolvedSeries['series'];
}

const { series } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const posts = await getPublishedPosts();
const resolved = resolveSeries(series, posts, base);

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={`${series.title} · 系列 · Chengshu`} description={series.description}>
  <div class="wrap">
    <section class="page-head">
      <nav class="breadcrumb" aria-label="面包屑">
        <span><a href={base}>Chengshu</a><span class="sep">/</span></span>
        <span><a href={`${base}series/`}>系列</a><span class="sep">/</span></span>
        <span>{series.title}</span>
      </nav>
      <h1>{series.title}</h1>
      <p class="intro">{series.tagline}</p>
      <p class="desc">{series.description}</p>
      {series.tags && series.tags.length > 0 && (
        <ul class="tags">
          {series.tags.map((tag) => (
            <li><a href={tagPath(tag, base)}>{tag}</a></li>
          ))}
        </ul>
      )}
    </section>

    <section class="home-section">
      {series.cover && (
        <figure class="cover">
          <img src={series.cover} alt={series.coverAlt ?? series.title} />
        </figure>
      )}

      <div class="section-head">
        <h2 id="chapters">目录</h2>
        <span class="progress">已更新 {resolved.publishedCount} 篇</span>
      </div>
      <ol class="chapters">
        {resolved.chapters.map((chapter) => (
          <li>
            <a href={chapter.href}>
              <span class="label">{chapter.label}</span>
              <span class="title">{chapter.title}</span>
              <span class="date"><time datetime={chapter.pubDate.toISOString()}>{formatDate(chapter.pubDate)}</time></span>
            </a>
          </li>
        ))}
        {series.upcoming?.map((chapter) => (
          <li class="upcoming">
            <span class="label">{chapter.label}</span>
            <span class="title">{chapter.title}</span>
            <span class="date">待更新</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
