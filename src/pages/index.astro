---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postPath, tagPath } from '../lib/posts';
import { getSeries, resolveSeries, seriesIndexPath } from '../lib/series';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const posts = await getPublishedPosts();
const series = getSeries().map((entry) => resolveSeries(entry, posts, base));

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title="Chengshu" description="关于设计、技术与日常观察的个人笔记。">
  <div class="wrap">
    <section class="home-hero">
      <p class="rubric">
        <span>个人写作</span>
        <span class="sep" aria-hidden="true"></span>
        <span>深圳</span>
        <span class="sep" aria-hidden="true"></span>
        <span>Agent 应用开发</span>
      </p>
      <h1>认真生活，<br />缓慢记录。</h1>
      <p class="intro">关于设计、技术，以及日常里值得被记住的小事。</p>
    </section>

    <section class="home-section" aria-labelledby="series">
      <div class="section-head">
        <h2 id="series">系列文章</h2>
        <a class="more" href={seriesIndexPath(base)}>全部系列 →</a>
      </div>
      <ul class="almanac">
        {series.map(({ series: entry, href, chapters, publishedCount }) => (
          <li class="row">
            <span class="date">{publishedCount} 篇</span>
            <span class="body">
              <a class="article-title" href={href}>{entry.title}</a>
              <span class="dek">{entry.tagline}</span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-section" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest">最近文章</h2>
        <a class="more" href={`${base}tags/`}>全部标签 →</a>
      </div>
      <ul class="almanac">
        {posts.map((post) => (
          <li class="row">
            <time class="date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <span class="body">
              <a class="article-title" href={postPath(post, base)}>{post.data.title}</a>
              {post.data.description && <span class="dek">{post.data.description}</span>}
              {(post.data.tags?.length ?? 0) > 0 && (
                <span class="tags">
                  {post.data.tags!.map((tag) => (
                    <a href={tagPath(tag, base)}>{tag}</a>
                  ))}
                </span>
              )}
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
