---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, tagPath } from '../../lib/posts';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const tags = await getAllTags();
---

<BaseLayout title="标签 · Chengshu" description="按标签浏览文章。">
  <div class="wrap">
    <section class="page-head">
      <nav class="breadcrumb" aria-label="面包屑">
        <span><a href={base}>Chengshu</a><span class="sep">/</span></span>
        <span>标签</span>
      </nav>
      <h1>按主题浏览</h1>
      <p class="intro">从每篇文章的 tags 字段汇总：{tags.length} 个标签，点击即可筛选。</p>
    </section>

    <section class="home-section">
      {tags.length === 0 ? (
        <p class="empty">还没有带标签的文章。</p>
      ) : (
        <ul class="tag-cloud" aria-label="全部标签">
          {tags.map(({ tag, count }) => (
            <li>
              <a href={tagPath(tag, base)}>
                <span class="name">{tag}</span>
                <span class="count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
