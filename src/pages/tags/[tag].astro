---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, postPath, tagPath } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const posts = await getPostsByTag(tag);

const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={`标签：${tag} · Chengshu`} description={`带「${tag}」标签的文章。`}>
  <div class="wrap">
    <section class="page-head">
      <nav class="breadcrumb" aria-label="面包屑">
        <span><a href={base}>Chengshu</a><span class="sep">/</span></span>
        <span><a href={`${base}tags/`}>标签</a><span class="sep">/</span></span>
        <span>{tag}</span>
      </nav>
      <h1>{tag}</h1>
      <p class="intro">{posts.length} 篇文章</p>
    </section>

    <section class="home-section">
      <ul class="almanac">
        {posts.map((post) => (
          <li class="row">
            <time class="date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <span class="body">
              <a class="article-title" href={postPath(post, base)}>{post.data.title}</a>
              {post.data.description && <span class="dek">{post.data.description}</span>}
              {(post.data.tags?.length ?? 0) > 0 && (
                <span class="tags">
                  {post.data.tags!.map((t) => (
                    <a href={tagPath(t, base)}>{t}</a>
                  ))}
                </span>
              )}
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
